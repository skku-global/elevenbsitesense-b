# In Vercel, set these under elevenbsitesense-b > Settings > Environment Variables.
# For local email delivery, copy this file to .env.local and enter the same settings.
# These are server-side variables. Keep their names exactly as shown.
RESEND_API_KEY=
CONTACT_FROM="Eleven B Site-Sense <info@elevenbsitesense.com>"
CONTACT_TO=info@elevenbsitesense.com
AUTOREPLY=true

# The connected Upstash integration supplies this pair in Vercel.
# Locally, use this pair or UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional additional exact HTTPS origins, separated by commas. The production
# address https://elevenbsitesense-b.vercel.app and current Vercel preview are automatic.
ALLOWED_ORIGINS=

# Existing additional exact-origin setting remains supported. No patterns here.
CONTACT_ALLOWED_ORIGINS=

# Supabase owner dashboard and enquiry inbox
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
