# Set these in Vercel server-side environment variables and in .env.local for vercel dev.
# Never use VITE_ prefixes for these variables.
RESEND_API_KEY=
CONTACT_FROM="Eleven B Site-Sense <info@elevenbsitesense.com>"
CONTACT_TO=info@elevenbsitesense.com
AUTOREPLY=true

# Upstash Redis REST credentials for distributed rate limits and delivery receipts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated HTTPS origins; official production origins are built in.
# When unset, Preview also permits this project's scoped pattern, and the exact git-main alias is allowed.
# The only supported pattern is https://elevenbsitesense11-*-adewalepolicy75-uxs-projects.vercel.app (Preview only).
ALLOWED_ORIGINS=

# Existing additional exact-origin setting remains supported. No patterns here.
CONTACT_ALLOWED_ORIGINS=
