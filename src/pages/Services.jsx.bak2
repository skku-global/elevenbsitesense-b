import { Seo, Hero, ServiceCard, Cta, Section } from '../components/Parts.jsx'
import { BRAND, OTHER, breadcrumbLd } from '../data/site.js'

const crumbs = [['/', 'Home'], ['/services/', 'Services']]
export default function Services() {
  return (
    <>
      <Seo path="/services/" title={`Building and Finishing Services | ${BRAND}`}
        desc="General building, P.O.P. ceilings, tiling, interlock paving, interior design and painting in Nigeria." ld={[breadcrumbLd(crumbs)]} />
      <Hero h1="Our services" p="Everything needed to build and finish the rest of your property, from general building and ceilings to tiling, paving, interiors and painting." crumbs={crumbs} buttons={false} />
      <Section alt><h2>Other services</h2><div className="grid service-grid">{OTHER.map((s) => <ServiceCard key={s.slug} slug={s.slug} />)}</div></Section>
      <Cta />
    </>
  )
}
